# Listen address. PORT is also honoured when ADDR is not set.
ADDR=:8080
# Public prefix used to build shortUrl values (no trailing slash).
BASE_URL=http://localhost:8080
# PostgreSQL connection string. Leave empty to use the in-memory store.
DATABASE_URL=
# Redis connection string for cache + distributed rate limiting. Leave empty for in-memory.
REDIS_URL=
# How long resolved links stay in the cache (Go duration).
CACHE_TTL=10m
# Token bucket per client IP: refill rate (tokens/second) and capacity.
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
# Trust X-Forwarded-For / X-Real-IP (enable only behind a reverse proxy you control).
TRUST_PROXY=false
# Allow destinations on localhost / private networks (local development only).
ALLOW_PRIVATE_URLS=false
# Capacity of the async click event buffer; events are dropped when it is full.
ANALYTICS_BUFFER=4096
# debug | info | warn | error
LOG_LEVEL=info
# Grace period for in-flight requests and the analytics flush on shutdown.
SHUTDOWN_TIMEOUT=10s
# Load Turkish demo links with 14 days of click history at startup (in-memory store only).
DEMO_SEED=false
